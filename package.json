{
  "name": "ingredient-convert-mcp",
  "version": "1.0.1",
  "description": "Cooking ingredient unit converter MCP server: cups, tbsp, tsp, ml, fl oz, grams and ounces for 30+ ingredients from a real per-ingredient density table, plus recipe scaling, bulk conversion and fraction helpers.",
  "type": "module",
  "license": "MIT",
  "author": "theluckystrike",
  "mcpName": "io.github.theluckystrike/ingredient-convert-mcp",
  "bin": {
    "ingredient-convert-mcp": "dist/stdio.js"
  },
  "main": "dist/tools.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "deploy": "npx wrangler@4 deploy"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/theluckystrike/ingredient-convert-mcp"
  },
  "homepage": "https://ingredientcalculator.com",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "ingredient-converter",
    "cooking-conversions",
    "cups-to-grams",
    "recipe-scaling",
    "baking"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
